PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=dtt
PG_USER=dtt
PG_PASSWORD=dttdttdtt

PG_URL="postgres://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${PG_DATABASE}"

REDIS_HOST=redis
REDIS_PORT=6379

RABBIT_URL=amqp://dtt:dttdttdtt@rabbit:5672
RABBIT_PREFETCH=100
RABBIT_EXCHANGE=items.topic
RABBIT_ADD_QUEUE=add.queue
RABBIT_SELECT_QUEUE=select.queue
RABBIT_REORDER_QUEUE=reorder.queue

WS_ADD_EVENT=items:added
WS_SELECT_EVENT=items:selection-changed
WS_REORDER_EVENT=items:reordered

MAX_ID=1000000000
MAX_LIMIT=20

SERVER_PORT=3000

LOG_LEVEL=info
NODE_ENV=developent